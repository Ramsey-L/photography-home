{
  "name": "zncu-photo-blog",
  "version": "2.0.0",
  "private": true,
  "description": "A Hexo and NexT.Muse photography journal.",
  "scripts": {
    "clean": "hexo clean",
    "build": "hexo clean && hexo generate --bail",
    "server": "hexo server --debug",
